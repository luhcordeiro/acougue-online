# Endereco da loja (sem barra no final)
LOJA_URL=https://texasbifedelivery.com.br

# Mesmo valor do secret PRINT_AGENT_TOKEN no Cloudflare
AGENT_TOKEN=cole-o-token-aqui

# Nome da impressora COMO APARECE no Windows, com parenteses e espacos.
# Ex: ELGIN i9(USB)
# Use SIMULADO para testar sem imprimir.
PRINTER=ELGIN i9(USB)

# Intervalo entre verificacoes, em milissegundos
INTERVALO_MS=3000
