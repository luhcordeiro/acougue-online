{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acougue-online",
  "main": "worker/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    // build do Vite; o Worker serve tudo que não for /api/trpc
    "directory": "./dist/public",
    "binding": "ASSETS",
    // SPA client-side: rotas como /admin/produtos devolvem index.html
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acougue-online",
      "database_id": "62956d6f-e954-409b-9db7-3563bbc4c155",
      "migrations_dir": "drizzle/migrations"
    }
  ],

  // Imagens dos produtos (acesso publico via r2.dev, ver secret R2_PUBLIC_URL)
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "acougue-online-imagens"
    }
  ],

  // Domínio próprio. DESATIVADO até os nameservers de texasbifedelivery.com
  // apontarem para a Cloudflare: publicar com uma rota cujo domínio não está
  // na conta faz o deploy inteiro falhar.
  //
  // Quando o painel mostrar o site como "Ativo", basta descomentar e publicar.
  // A Cloudflare cria os registros DNS e o certificado sozinha.
  // "routes": [
  //   { "pattern": "texasbifedelivery.com", "custom_domain": true },
  //   { "pattern": "www.texasbifedelivery.com", "custom_domain": true }
  // ],

  "observability": {
    "enabled": true
  },

  // Somente valores NÃO sensíveis. Segredos (JWT_SECRET, R2_PUBLIC_URL)
  // vão por `wrangler secret put`, nunca aqui.
  "vars": {
    "NODE_ENV": "production"
  }
}
